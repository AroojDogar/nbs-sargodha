# Google Gemini key for the NBS AI Assistant (get one free at https://aistudio.google.com/apikey).
# Copy this file to .env.local and paste your key. On Vercel, add it under Settings > Environment Variables.
GEMINI_API_KEY=
# Optional: a Gemini model to try first (the code falls back to others if it is busy).
# GEMINI_MODEL=gemini-3.5-flash

# Supabase for the online attendance portal (Project Settings > API in supabase.com).
# Use the project URL and the publishable (anon) key, never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
